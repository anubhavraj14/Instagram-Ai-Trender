# Copy this file to .env and fill in your key.
# Get a FREE key (no billing needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Optional overrides
PORT=3000
GEMINI_MODEL=gemini-3.5-flash

# Your niche profile (used to tailor the research). Edit freely.
CREATOR_NICHE=Helping creators grow on Instagram through Reels, hooks, storytelling, editing, AI tools, creator strategy, and content ideas.

# --- Private saved-list sync (set these when hosting) ---
# A secret passcode you choose; required to view/edit your saved ideas online.
# Leave empty for local dev to keep saved-list open.
APP_PASSCODE=

# Upstash Redis (free, no card) -> https://console.upstash.com
# Create a database, then copy its "REST API" URL + token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
